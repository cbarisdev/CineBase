<?xml version="1.0" encoding="utf-8"?>
<!-- Rebuilt from the complete XML discussed previously plus the partial video preview. Not frame-for-frame verified. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F10"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/imgDetailPoster"
            android:layout_width="0dp"
            android:layout_height="520dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            android:contentDescription="Film afişi"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/heroGradient"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/gradient_poster_bottom"
            app:layout_constraintTop_toTopOf="@id/imgDetailPoster"
            app:layout_constraintBottom_toBottomOf="@id/imgDetailPoster"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:padding="0dp"
            android:text=""
            android:contentDescription="Geri"
            app:cornerRadius="14dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp"
            app:backgroundTint="#141414"
            app:icon="@android:drawable/ic_media_previous"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavorite"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:padding="0dp"
            android:text=""
            android:contentDescription="Favorilere ekle"
            app:cornerRadius="14dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp"
            app:backgroundTint="#141414"
            app:icon="@drawable/ic_favorite_border"
            app:iconTint="#E50914"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="64dp"
            android:text="Film Başlığı"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/imgDetailPoster" />

        <LinearLayout
            android:id="@+id/rowMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/imgDetailPoster">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp">
                <TextView
                    android:id="@+id/txtDetailRating"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="⭐ 8.2"
                    android:textColor="#46D369"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp">
                <TextView
                    android:id="@+id/txtDetailYear"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="2023"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#141414"
            app:layout_constraintTop_toBottomOf="@id/imgDetailPoster"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">
                <TextView
                    android:id="@+id/txtDescTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Açıklama"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
                <TextView
                    android:id="@+id/txtDetailDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Filmin açıklaması buraya gelecek..."
                    android:textColor="#D0FFFFFF"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtDescTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/lblComments"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="18dp"
            android:text="Yorumlar"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cardDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardComments"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#141414"
            app:layout_constraintTop_toBottomOf="@id/lblComments"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilComment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="#22FFFFFF"
                    app:hintTextColor="#B3FFFFFF"
                    android:textColorHint="#B3FFFFFF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnSendComment">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtComment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Yorumunu yaz..."
                        android:inputType="textMultiLine"
                        android:maxLines="4"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#80FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendComment"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text=""
                    android:contentDescription="Yorumu gönder"
                    app:cornerRadius="16dp"
                    app:backgroundTint="#E50914"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:layout_constraintTop_toTopOf="@id/tilComment"
                    app:layout_constraintBottom_toBottomOf="@id/tilComment"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/dividerComments"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#12FFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/tilComment"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerComments"
                    android:layout_width="0dp"
                    android:layout_height="360dp"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:paddingBottom="6dp"
                    app:layout_constraintTop_toBottomOf="@id/dividerComments"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:listitem="@layout/item_comment" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <View
            android:layout_width="0dp"
            android:layout_height="14dp"
            app:layout_constraintTop_toBottomOf="@id/cardComments"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
